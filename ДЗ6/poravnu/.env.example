# Скопируйте в .env.local и подставьте значения из Supabase: Project Settings → API Keys.
# Ключ publishable (anon) публичный: он виден в браузере, данные защищают политики RLS.
# Ключи service_role / secret и пароль базы сюда НЕ кладите.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
